---
import { withBase } from '../utils/paths';
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Próximos partidos - Afume</title>
    <link rel="stylesheet" href={withBase("stylesheet.css")} type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <!--NAV-->
    <nav>
        <ul>
            <li><a href={withBase("")}><img src={withBase("imagenes/afume logo.svg")} alt="logo de afume" width="200px"></a></li>
            <li><a class="links" href={withBase("news/")}>NOTICIAS</a></li>
            <li><a class="links" href={withBase("next_matches/")}>PRÓXIMOS PARTIDOS</a></li>
            <li><a class="links" href={withBase("equipos/")}>EQUIPOS</a></li>
            <li><a class="links" href={withBase("competencies/")}>COMPETENCIAS</a></li>
            <li><a class="links" href={withBase("about_us/")}>SOBRE NOSOTROS</a></li>
        </ul>
    </nav>
    
    <!--CUERPO DE PÁGINA-->
    <h1>PARTIDOS DENTRO DE LOS PRÓXIMOS 7 DÍAS</h1>
    <table class="next_matches">
        <tr>
            <th colspan="4"><img src={withBase("imagenes/lpf.svg")} alt="liga profesional argentina">LIGA PROFESIONAL ARGENTINA</th>
        </tr>
        <tr>
            <td class="td_hour">Mar 27/10</td>
            <td class="td_left">Argentinos Juniors<img src={withBase("imagenes/aaaj.webp")} alt="argentinos juniors" ></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/csir.webp")} alt="independiente rivadavia">Independiente Rivadavia</td>
        </tr>
        <tr>
            <td class="td_hour">Dom 1/11</td>
            <td class="td_left">Lanús<img src={withBase("imagenes/lanus.webp")} alt="lanús"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/gimnasia.png")} alt="gimnasia de mendoza">Gimnasia de Mendoza</td>
        </tr>
    </table>
    <table class="next_matches">
        <tr>
            <th colspan="4"><img src={withBase("imagenes/b nacional.svg")} alt="b nacional">PRIMERA NACIONAL</th>
        </tr>
        <tr>
            <td class="td_hour">17:00</td>
            <td class="td_left">Mitre<img src={withBase("imagenes/mitre.png")} alt="mitre"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/godoy cruz.png")} alt="godoy cruz">Godoy Cruz</td>
        </tr>
        <tr>
            <td class="td_hour">17:00</td>
            <td class="td_left">Deportivo Maipú<img src={withBase("imagenes/maipu.svg")} alt="deportivo maipú"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/guemes.png")} alt="güemes">Güemes</td>
        </tr>
    </table>
    <table class="next_matches">
        <tr>
            <th colspan="4"><img src={withBase("imagenes/lgm.WebP")} alt="liga mendocina">LIGA MENDOCINA</th>
        </tr>
        <tr>
            <td class="td_hour">16:30</td>
            <td class="td_left">Deportivo Guaymallén<img src={withBase("imagenes/guaymallen.png")} alt="deportivo guaymallen"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/andes talleres.svg")} alt="andes talleres">Andes Talleres</td>
        </tr>
        <tr>
            <td class="td_hour">16:30</td>
            <td class="td_left">Murialdo<img src={withBase("imagenes/murialdo.svg")} alt="murialdo"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/chacras.svg")} alt="chacras de coria">Academia Chacras de Coria</td>
        </tr>
        <tr>
            <td class="td_hour">16:30</td>
            <td class="td_left">FADEP<img src={withBase("imagenes/fadep.svg")} alt="fadep"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/gimnasia.png")} alt="gimnasia de mendoza">Gimnasia de Mendoza</td>
        </tr>
        <tr>
            <td class="td_hour">Lun     11:00</td>
            <td class="td_left">San Martín de Mendoza<img src={withBase("imagenes/san martin.png")} alt="san martin de mendoza"></td>
            <td class="td_result">vs</td>
            <td class="td_right"><img src={withBase("imagenes/argentino.png")} alt="argentino de mendoza">Argentino de Mendoza</td>
        </tr>
    </table>
    
    <!--FOOTER-->
    <footer>
        <div id="redes">
            <a href="https://x.com/soytarufa" target="_blank"><img src={withBase("imagenes/x.svg")} alt="twitter afume"></a>
            <a href="https://instagram.com/afumendoza" target="_blank"><img src={withBase("imagenes/ig.svg")} alt="instagram afume"></a>
        </div>
        <h1>CONTACTO</h1>
        <h3>Asociación Fútbol de Mendoza (AFUME)</h3>
        <div id="info_empresa">
            <img src={withBase("imagenes/ubicacion.svg")} alt="ubicación afume">
            <p>Pedro Molina y Perú - Ciudad de Mendoza.</p>
            <img src={withBase("imagenes/correo.svg")} alt="correo afume">
            <p>support.afume@gmail.com</p>
            <img src={withBase("imagenes/teléfono.svg")} alt="teléfono afume">
            <p>+54 9 261 623-4614</p>
        </div>
        <div>
            <img src={withBase("imagenes/afume logo.svg")} alt="afume logo" width="400px">
        </div>
        <p>Copyright © 2026 AFUME | Todos los derechos reservados.</p>
    </footer>
</body>
</html>