---
import { withBase } from '../../utils/paths';
import equipos from '../../data/equipos.json';

const ligaProfesional = equipos.filter((e) => e.division === 'Liga Profesional Argentina');
const primeraNacional = equipos.filter((e) => e.division === 'Primera Nacional');
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Equipos - Afume</title>
    <link rel="stylesheet" href={withBase("stylesheet.css")} type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <!--NAV-->
    <nav>
        <ul>
            <li><a href={withBase("")}><img src={withBase("imagenes/afume logo.svg")} alt="logo de afume" width="200px"></a></li>
            <li><a class="links" href={withBase("news/")}>NOTICIAS</a></li>
            <li><a class="links" href={withBase("next_matches/")}>PRÓXIMOS PARTIDOS</a></li>
            <li><a class="links" href={withBase("equipos/")}>EQUIPOS</a></li>
            <li><a class="links" href={withBase("competencies/")}>COMPETENCIAS</a></li>
            <li><a class="links" href={withBase("about_us/")}>SOBRE NOSOTROS</a></li>
        </ul>
    </nav>
    
    <!--CUERPO DE PÁGINA-->
    <h1>EQUIPOS MENDOCINOS</h1>
    <h2>LIGA PROFESIONAL ARGENTINA</h2>
    <div class="divisiones">
        {ligaProfesional.map((equipo) => (
            <a href={withBase(`equipos/${equipo.id}/`)}><img src={withBase(equipo.escudo)} alt={`Escudo de ${equipo.nombre}`}></a>
        ))}
    </div>
    <h2>PRIMERA NACIONAL</h2>
    <div class="divisiones">
        {primeraNacional.map((equipo) => (
            <a href={withBase(`equipos/${equipo.id}/`)}><img src={withBase(equipo.escudo)} alt={`Escudo de ${equipo.nombre}`}></a>
        ))}
    </div>
    <h2>FEDERAL A</h2>
    <div class="divisiones">
        <img src={withBase("imagenes/hlh.png")} alt="HURACAN LAS HERAS">
        <img src={withBase("imagenes/fadep.svg")} alt="fundacion amigos deportivos">
        <img src={withBase("imagenes/san martin.png")} alt="san martin">
    </div>
    <h2>LIGA MENDOCINA</h2>
    <div class="divisiones">
        <img src={withBase("imagenes/argentino.png")} alt="club argentino de mendoza">
        <img src={withBase("imagenes/chacras.svg")} alt="club chacras de coria">
        <img src={withBase("imagenes/andes talleres.svg")} alt="andes talleres">
        <img src={withBase("imagenes/guaymallen.png")} alt="fundacion guaymallen">
        <img src={withBase("imagenes/murialdo.svg")} alt="murialdo">
        <img src={withBase("imagenes/lujan.png")} alt="lujan sport">
        <img src={withBase("imagenes/gutierrez.svg")} alt="gutierrez sport">
        <img src={withBase("imagenes/palmito.png")} alt="palmira de san martin">
    </div>
    
    <!--FOOTER-->
    <footer>
        <div id="redes">
            <a href="https://x.com/soytarufa" target="_blank"><img src={withBase("imagenes/x.svg")} alt="twitter afume"></a>
            <a href="https://instagram.com/afumendoza" target="_blank"><img src={withBase("imagenes/ig.svg")} alt="instagram afume"></a>
        </div>
        <h1>CONTACTO</h1>
        <h3>Asociación Fútbol de Mendoza (AFUME)</h3>
        <div id="info_empresa">
            <img src={withBase("imagenes/ubicacion.svg")} alt="ubicación afume">
            <p>Pedro Molina y Perú - Ciudad de Mendoza.</p>
            <img src={withBase("imagenes/correo.svg")} alt="correo afume">
            <p>support.afume@gmail.com</p>
            <img src={withBase("imagenes/teléfono.svg")} alt="teléfono afume">
            <p>+54 9 261 623-4614</p>
        </div>
        <div>
            <img src={withBase("imagenes/afume logo.svg")} alt="afume logo" width="400px">
        </div>
        <p>Copyright © 2026 AFUME | Todos los derechos reservados.</p>
    </footer>
</body>
</html>